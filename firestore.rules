rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * GRIMAUTOMATA SECURITY RULES
     *
     * Core Philosophy:
     * This ruleset implements a strict user-ownership model where all data is hierarchically 
     * organized under the user's unique identifier. Security is enforced by verifying the 
     * requester's identity against the document path.
     *
     * Data Structure:
     * - /users/{userId}: The root user profile.
     * - /users/{userId}/moonIdCredentials/{credentialId}: Sensitive Moon ID credentials.
     * - /users/{userId}/automationSettings/{settingId}: User-specific bot configurations.
     * - /users/{userId}/activityLogs/{logId}: Real-time logs generated by the bot.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get, list: if true;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      // Verification against path (userId) is more resilient than verification against potentially missing resource.data.id
      allow update: if isExistingOwner(userId) && request.resource.data.id == userId;
      allow delete: if isExistingOwner(userId);

      match /moonIdCredentials/{credentialId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId && request.resource.data.id == credentialId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == userId && request.resource.data.id == credentialId;
        allow delete: if isExistingOwner(userId);
      }

      match /automationSettings/{settingId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId && request.resource.data.id == settingId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == userId && request.resource.data.id == settingId;
        allow delete: if isExistingOwner(userId);
      }

      match /activityLogs/{logId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId && request.resource.data.id == logId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == userId && request.resource.data.id == logId;
        allow delete: if isExistingOwner(userId);
      }
    }
  }
}