rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * GRIMAUTOMATA SECURITY RULES
     *
     * Core Philosophy:
     * This ruleset implements a strict user-ownership model where all data is hierarchically 
     * organized under the user's unique identifier. Security is enforced by verifying the 
     * requester's identity against the document path.
     *
     * Data Structure:
     * - /users/{userId}: The root user profile.
     * - /users/{userId}/moonIdCredentials/{credentialId}: Sensitive Moon ID credentials.
     * - /users/{userId}/automationSettings/{settingId}: User-specific bot configurations.
     * - /users/{userId}/activityLogs/{logId}: Real-time logs generated by the bot.
     *
     * Key Security Decisions:
     * 1. Public Profiles: Basic user documents are publicly readable to facilitate 
     *    social features, but write operations are strictly limited to the document owner.
     * 2. Private Subcollections: All sub-data (credentials, settings, logs) is private 
     *    and restricted solely to the owner for both reading and writing.
     * 3. Identity Verification: All write operations rely on the Firebase Auth UID.
     * 4. Relational Integrity: On creation, documents must include a field that 
     *    matches the parent user ID to prevent data orphaned from its owner.
     */

    // --- Helper Functions ---

    /**
     * @description Simple check if the request is from an authenticated user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Combined check for ownership and document existence for destructive operations.
     */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    /**
     * @description Rules for User profile documents.
     * @path /users/{userId}
     * @allow (get) Any user can view basic profile info.
     * @allow (create) User with UID 'abc' creating /users/abc.
     * @deny (create) User with UID 'abc' creating /users/xyz.
     * @principle Ownership / Self-Creation.
     */
    match /users/{userId} {
      allow get, list: if true;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      /**
       * @description Rules for Moon ID credentials.
       * @path /users/{userId}/moonIdCredentials/{credentialId}
       * @allow (create) Owner creating a credential linked to their own userId.
       * @deny (get) User 'abc' trying to read credentials for user 'xyz'.
       * @principle Ownership.
       */
      match /moonIdCredentials/{credentialId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId && request.resource.data.id == credentialId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId && request.resource.data.id == resource.data.id;
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Rules for user-specific bot automation settings.
       * @path /users/{userId}/automationSettings/{settingId}
       * @allow (list) Owner listing their own automation settings.
       * @deny (update) User trying to change the 'userId' field of an existing setting.
       * @principle Ownership and Relational Integrity.
       */
      match /automationSettings/{settingId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId && request.resource.data.id == settingId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId && request.resource.data.id == resource.data.id;
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Rules for bot activity logs.
       * @path /users/{userId}/activityLogs/{logId}
       * @allow (create) The authenticated user logging an action to their own log tree.
       * @deny (list) Anonymous access to activity logs.
       * @principle Path-based authorization for high-volume logs.
       */
      match /activityLogs/{logId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId && request.resource.data.id == logId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId && request.resource.data.id == resource.data.id;
        allow delete: if isExistingOwner(userId);
      }
    }
  }
}