
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * GRIMAUTOMATA SECURITY RULES
     *
     * Core Philosophy:
     * This ruleset implements a strict user-ownership model where all data is hierarchically 
     * organized under the user's unique identifier. Security is enforced by verifying the 
     * requester's identity against the document path.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get, list: if true;
      allow create, update, delete: if isOwner(userId);

      match /moonIdCredentials/{credentialId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      match /automationSettings/{settingId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      match /activityLogs/{logId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }
  }
}
